rules_version='2';
service cloud.firestore { match /databases/{db}/documents {
  function owner(){return request.auth!=null && request.auth.token.email=='you@example.com';} // <- your owner email
  function ok(){return request.auth!=null && exists(/databases/$(db)/documents/members/$(request.auth.uid))
    && !get(/databases/$(db)/documents/members/$(request.auth.uid)).data.banned;}
  match /members/{u}{
    allow read: if request.auth!=null;
    allow create: if request.auth.uid==u && request.resource.data.banned==false;
    allow update,delete: if owner();
  }
  match /messages/{m}{
    allow read: if ok()||owner();
    allow create: if (ok()||owner()) && request.resource.data.uid==request.auth.uid;
    allow delete: if owner();
  }
}}
